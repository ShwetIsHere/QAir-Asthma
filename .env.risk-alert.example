# Predictive Risk Alert System - Environment Variables

# ===========================================
# OpenWeather API (Required for Risk Alerts)
# ===========================================
# Get your free API key: https://openweathermap.org/api
# Free tier: 1000 calls/day
EXPO_PUBLIC_OPENWEATHER_API_KEY=your_openweather_api_key_here

# ===========================================
# Ambee Pollen API (Optional - Paid Service)
# ===========================================
# Get API key: https://www.getambee.com/
# Note: System works without this (uses default pollen values)
EXPO_PUBLIC_AMBEE_API_KEY=your_ambee_api_key_here

